{
  "name": "@blackbox/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run db:generate && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "node ./scripts/require-test-database-url.mjs && prisma migrate deploy",
    "db:migrate:verify": "node ./scripts/require-test-database-url.mjs && prisma migrate status",
    "db:validate": "prisma validate",
    "lint": "eslint .",
    "test": "node ./scripts/run-integration-if-configured.mjs",
    "test:integration": "node ./scripts/require-test-database-url.mjs && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blackbox/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@blackbox/config": "workspace:*",
    "@types/node": "24.13.6",
    "@types/pg": "8.15.6",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
