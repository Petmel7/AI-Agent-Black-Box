generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                     String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  repositories           Repository[]
  runs                   Run[]
  batches                EvidenceBatch[]
  events                 EvidenceEvent[]
  memberships            EvidenceBatchEvent[]
  artifacts              ArtifactDeclaration[]
  references             EvidenceEventArtifact[]
  processingIntents      ProcessingIntent[]
  processingReceipts     ProcessingApplicationReceipt[]
  processingStates       RunProcessingState[]
  processingFailures     ProcessingAttemptFailure[]
  coreRunProjections     CoreRunProjection[]
  fileRunProjections     FileRunProjection[]
  fileChangeProjections  FileChangeProjection[]
  artifactUploadAttempts ArtifactUploadAttempt[]
  findingsRunProjections FindingsRunProjection[]
  findingRuleResults     FindingRuleResult[]
  findingReferences      FindingEvidenceReference[]

  @@map("organizations")
}

model Repository {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "repositories_organization_id_fkey")
  runs                   Run[]
  coreRunProjections     CoreRunProjection[]
  fileRunProjections     FileRunProjection[]
  fileChangeProjections  FileChangeProjection[]
  findingsRunProjections FindingsRunProjection[]

  @@unique([organizationId, id], map: "repositories_org_id_key")
  @@map("repositories")
}

model Run {
  id                     String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String                         @map("organization_id") @db.Uuid
  repositoryId           String                         @map("repository_id") @db.Uuid
  canonicalRunId         String                         @map("canonical_run_id") @db.Uuid
  createdAt              DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization           Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "runs_organization_id_fkey")
  repository             Repository                     @relation(fields: [organizationId, repositoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "runs_org_repository_fkey")
  batches                EvidenceBatch[]
  events                 EvidenceEvent[]
  memberships            EvidenceBatchEvent[]
  artifacts              ArtifactDeclaration[]
  references             EvidenceEventArtifact[]
  processingIntents      ProcessingIntent[]
  processingReceipts     ProcessingApplicationReceipt[]
  processingStates       RunProcessingState[]
  processingFailures     ProcessingAttemptFailure[]
  artifactUploadAttempts ArtifactUploadAttempt[]
  coreRunProjection      CoreRunProjection?
  fileRunProjection      FileRunProjection?
  fileChangeProjections  FileChangeProjection[]
  findingsRunProjection  FindingsRunProjection?
  findingRuleResults     FindingRuleResult[]
  findingReferences      FindingEvidenceReference[]

  @@unique([organizationId, canonicalRunId], map: "runs_org_canonical_run_id_key")
  @@unique([organizationId, id], map: "runs_org_id_key")
  @@map("runs")
}

model EvidenceBatch {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  runId             String               @map("run_id") @db.Uuid
  canonicalBatchId  String               @map("canonical_batch_id") @db.Uuid
  schemaVersion     Int                  @map("schema_version")
  sentAt            DateTime             @map("sent_at") @db.Timestamptz(3)
  receivedAt        DateTime             @default(now()) @map("received_at") @db.Timestamptz(3)
  rawBatch          Json                 @map("raw_batch") @db.JsonB
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "batches_organization_id_fkey")
  run               Run                  @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "batches_org_run_fkey")
  memberships       EvidenceBatchEvent[]
  processingIntents ProcessingIntent[]

  @@unique([organizationId, canonicalBatchId], map: "batches_org_canonical_batch_id_key")
  @@unique([organizationId, runId, id], map: "batches_org_run_id_key")
  @@index([organizationId, runId, receivedAt], map: "batches_org_run_received_idx")
  @@map("evidence_batches")
}

model EvidenceEvent {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  runId             String                     @map("run_id") @db.Uuid
  canonicalEventId  String                     @map("canonical_event_id") @db.Uuid
  schemaVersion     Int                        @map("schema_version")
  sequence          BigInt
  kind              String
  observedAt        DateTime                   @map("observed_at") @db.Timestamptz(3)
  occurredAt        DateTime?                  @map("occurred_at") @db.Timestamptz(3)
  receivedAt        DateTime                   @default(now()) @map("received_at") @db.Timestamptz(3)
  rawEvent          Json                       @map("raw_event") @db.JsonB
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "events_organization_id_fkey")
  run               Run                        @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "events_org_run_fkey")
  memberships       EvidenceBatchEvent[]
  artifactLinks     EvidenceEventArtifact[]
  findingReferences FindingEvidenceReference[]

  @@unique([organizationId, canonicalEventId], map: "events_org_canonical_event_id_key")
  @@unique([runId, sequence], map: "events_run_sequence_key")
  @@unique([organizationId, runId, id], map: "events_org_run_id_key")
  @@index([organizationId, runId, kind], map: "events_org_run_kind_idx")
  @@map("evidence_events")
}

model EvidenceBatchEvent {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  runId          String        @map("run_id") @db.Uuid
  batchId        String        @map("batch_id") @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  position       BigInt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "batch_events_organization_id_fkey")
  run            Run           @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "batch_events_org_run_fkey")
  batch          EvidenceBatch @relation(fields: [organizationId, runId, batchId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "batch_events_org_run_batch_fkey")
  event          EvidenceEvent @relation(fields: [organizationId, runId, eventId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "batch_events_org_run_event_fkey")

  @@unique([batchId, position], map: "batch_events_batch_position_key")
  @@unique([batchId, eventId], map: "batch_events_batch_event_key")
  @@map("evidence_batch_events")
}

model ArtifactDeclaration {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                     @map("organization_id") @db.Uuid
  runId                 String                     @map("run_id") @db.Uuid
  canonicalArtifactId   String                     @map("canonical_artifact_id") @db.Uuid
  kind                  String
  mediaType             String                     @map("media_type")
  byteLength            BigInt                     @map("byte_length")
  sha256                String
  redactionApplied      Boolean                    @map("redaction_applied")
  redactionRuleset      String?                    @map("redaction_ruleset_version")
  compression           String?
  characterEncoding     String?                    @map("character_encoding")
  receivedAt            DateTime                   @default(now()) @map("received_at") @db.Timestamptz(3)
  rawReference          Json                       @map("raw_reference") @db.JsonB
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "artifacts_organization_id_fkey")
  run                   Run                        @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "artifacts_org_run_fkey")
  eventLinks            EvidenceEventArtifact[]
  uploadAttempts        ArtifactUploadAttempt[]
  processingIntents     ProcessingIntent[]
  fileChangeProjections FileChangeProjection[]
  findingReferences     FindingEvidenceReference[]

  @@unique([organizationId, canonicalArtifactId], map: "artifacts_org_canonical_artifact_id_key")
  @@unique([organizationId, runId, id], map: "artifacts_org_run_id_key")
  @@index([organizationId, runId, kind], map: "artifacts_org_run_kind_idx")
  @@map("artifact_declarations")
}

enum ArtifactUploadState {
  ISSUED    @map("issued")
  VERIFYING @map("verifying")
  VERIFIED  @map("verified")
  REJECTED  @map("rejected")
  EXPIRED   @map("expired")
}

model ArtifactUploadAttempt {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  runId                 String                 @map("run_id") @db.Uuid
  artifactDeclarationId String                 @map("artifact_declaration_id") @db.Uuid
  objectKey             String                 @unique(map: "artifact_upload_attempts_object_key_key") @map("object_key")
  state                 ArtifactUploadState    @default(ISSUED)
  issuedAt              DateTime               @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt             DateTime               @map("expires_at") @db.Timestamptz(3)
  verificationLeaseId   String?                @map("verification_lease_id") @db.Uuid
  leaseExpiresAt        DateTime?              @map("lease_expires_at") @db.Timestamptz(3)
  observedByteLength    BigInt?                @map("observed_byte_length")
  observedSha256        String?                @map("observed_sha256")
  verifiedAt            DateTime?              @map("verified_at") @db.Timestamptz(3)
  rejectedAt            DateTime?              @map("rejected_at") @db.Timestamptz(3)
  expiredAt             DateTime?              @map("expired_at") @db.Timestamptz(3)
  lastErrorCode         String?                @map("last_error_code")
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "artifact_upload_attempts_organization_id_fkey")
  run                   Run                    @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "artifact_upload_attempts_org_run_fkey")
  artifactDeclaration   ArtifactDeclaration    @relation(fields: [organizationId, runId, artifactDeclarationId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "artifact_upload_attempts_org_run_artifact_fkey")
  fileChangeProjections FileChangeProjection[]

  @@unique([organizationId, runId, id], map: "artifact_upload_attempts_org_run_id_key")
  @@unique([organizationId, runId, artifactDeclarationId, id], map: "artifact_upload_attempts_org_run_artifact_id_key")
  @@index([organizationId, artifactDeclarationId, state], map: "artifact_upload_attempts_artifact_state_idx")
  @@map("artifact_upload_attempts")
}

model EvidenceEventArtifact {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  runId             String                     @map("run_id") @db.Uuid
  eventId           String                     @map("event_id") @db.Uuid
  artifactId        String                     @map("artifact_id") @db.Uuid
  jsonPointer       String                     @map("json_pointer")
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "event_artifacts_organization_id_fkey")
  run               Run                        @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_artifacts_org_run_fkey")
  event             EvidenceEvent              @relation(fields: [organizationId, runId, eventId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_artifacts_org_run_event_fkey")
  artifact          ArtifactDeclaration        @relation(fields: [organizationId, runId, artifactId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "event_artifacts_org_run_artifact_fkey")
  findingReferences FindingEvidenceReference[] @relation("FindingReferenceEventArtifact")

  @@unique([eventId, jsonPointer], map: "event_artifacts_event_pointer_key")
  @@unique([organizationId, runId, eventId, artifactId, jsonPointer], map: "event_artifacts_org_run_event_artifact_pointer_key")
  @@map("evidence_event_artifacts")
}

enum ProcessingIntentKind {
  EVIDENCE_BATCH_ACCEPTED @map("evidence_batch.accepted")
  ARTIFACT_VERIFIED       @map("artifact.verified")
}

enum ProcessingIntentState {
  PENDING   @map("pending")
  LEASED    @map("leased")
  DELIVERED @map("delivered")
  BLOCKED   @map("blocked")
}

model ProcessingIntent {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String                     @map("organization_id") @db.Uuid
  runId                 String                     @map("run_id") @db.Uuid
  batchId               String?                    @map("batch_id") @db.Uuid
  artifactDeclarationId String?                    @map("artifact_declaration_id") @db.Uuid
  kind                  ProcessingIntentKind
  state                 ProcessingIntentState      @default(PENDING)
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  availableAt           DateTime                   @default(now()) @map("available_at") @db.Timestamptz(3)
  attemptCount          Int                        @default(0) @map("attempt_count")
  lastAttemptAt         DateTime?                  @map("last_attempt_at") @db.Timestamptz(3)
  leaseExpiresAt        DateTime?                  @map("lease_expires_at") @db.Timestamptz(3)
  leaseId               String?                    @map("lease_id") @db.Uuid
  queueMessageId        BigInt?                    @map("queue_message_id")
  deliveredAt           DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  lastErrorCode         String?                    @map("last_error_code")
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processing_intents_organization_id_fkey")
  run                   Run                        @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_intents_org_run_fkey")
  batch                 EvidenceBatch?             @relation(fields: [organizationId, runId, batchId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_intents_org_run_batch_fkey")
  artifactDeclaration   ArtifactDeclaration?       @relation(fields: [organizationId, runId, artifactDeclarationId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_intents_org_run_artifact_fkey")
  processingFailures    ProcessingAttemptFailure[]

  @@unique([organizationId, runId, id], map: "processing_intents_org_run_id_key")
  @@index([state, availableAt], map: "processing_intents_state_available_idx")
  @@map("processing_intents")
}

enum RunProcessingStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  RETRYING   @map("retrying")
  READY      @map("ready")
  FAILED     @map("failed")
}

model ProcessingApplicationReceipt {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  runId            String       @map("run_id") @db.Uuid
  intentId         String       @map("intent_id") @db.Uuid
  projectorName    String       @map("projector_name")
  projectorVersion Int          @map("projector_version")
  appliedAt        DateTime     @default(now()) @map("applied_at") @db.Timestamptz(3)
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processing_receipts_organization_id_fkey")
  run              Run          @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_receipts_org_run_fkey")

  @@unique([intentId, projectorName, projectorVersion], map: "processing_receipts_intent_projector_key")
  @@map("processing_application_receipts")
}

model RunProcessingState {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  runId              String              @map("run_id") @db.Uuid
  projectorName      String              @map("projector_name")
  projectorVersion   Int                 @map("projector_version")
  state              RunProcessingStatus @default(PENDING)
  leaseId            String?             @map("lease_id") @db.Uuid
  leaseExpiresAt     DateTime?           @map("lease_expires_at") @db.Timestamptz(3)
  attemptDeadlineAt  DateTime?           @map("attempt_deadline_at") @db.Timestamptz(3)
  activeIntentId     String?             @map("active_intent_id") @db.Uuid
  attemptFingerprint String?             @map("attempt_source_fingerprint")
  attemptCount       Int                 @default(0) @map("attempt_count")
  availableAt        DateTime            @default(now()) @map("available_at") @db.Timestamptz(3)
  sourceEventCount   Int?                @map("source_event_count")
  sourceMaxSequence  BigInt?             @map("source_max_sequence")
  sourceFingerprint  String?             @map("source_fingerprint")
  completedAt        DateTime?           @map("completed_at") @db.Timestamptz(3)
  lastErrorCode      String?             @map("last_error_code")
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processing_states_organization_id_fkey")
  run                Run                 @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_states_org_run_fkey")

  @@unique([organizationId, runId, projectorName], map: "processing_states_org_run_projector_key")
  @@map("run_processing_states")
}

model ProcessingAttemptFailure {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  runId             String           @map("run_id") @db.Uuid
  intentId          String           @map("intent_id") @db.Uuid
  projectorName     String           @map("projector_name")
  projectorVersion  Int              @map("projector_version")
  sourceFingerprint String?          @map("source_fingerprint")
  attemptCount      Int              @map("attempt_count")
  errorCode         String           @map("error_code")
  failedAt          DateTime         @default(now()) @map("failed_at") @db.Timestamptz(3)
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "processing_attempt_failures_organization_id_fkey")
  run               Run              @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_attempt_failures_org_run_fkey")
  intent            ProcessingIntent @relation(fields: [organizationId, runId, intentId], references: [organizationId, runId, id], onDelete: Restrict, onUpdate: Restrict, map: "processing_attempt_failures_org_run_intent_fkey")

  @@unique([intentId, projectorName, projectorVersion], map: "processing_attempt_failures_intent_projector_key")
  @@index([organizationId, runId, failedAt], map: "processing_attempt_failures_org_run_failed_idx")
  @@map("processing_attempt_failures")
}

model CoreRunProjection {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String                      @map("organization_id") @db.Uuid
  repositoryId         String                      @map("repository_id") @db.Uuid
  runId                String                      @unique(map: "core_run_projections_run_id_key") @map("run_id") @db.Uuid
  projectorName        String                      @map("projector_name")
  projectorVersion     Int                         @map("projector_version")
  sourceEventCount     Int                         @map("source_event_count")
  sourceMaxSequence    BigInt?                     @map("source_max_sequence")
  sourceFingerprint    String                      @map("source_fingerprint")
  startedEventId       String?                     @map("started_event_id") @db.Uuid
  startedSequence      BigInt?                     @map("started_sequence")
  finishedEventId      String?                     @map("finished_event_id") @db.Uuid
  finishedSequence     BigInt?                     @map("finished_sequence")
  adapter              String?
  provider             String?
  observedOutcome      String?                     @map("observed_outcome")
  durationMs           BigInt?                     @map("duration_ms")
  evidenceCompleteness String                      @map("evidence_completeness")
  completenessReasons  Json                        @map("completeness_reasons") @db.JsonB
  commandCount         Int?                        @map("command_count")
  toolCallCount        Int?                        @map("tool_call_count")
  testObservationState String                      @map("test_observation_state")
  testCounts           Json                        @map("test_counts") @db.JsonB
  tokenAggregates      Json                        @map("token_aggregates") @db.JsonB
  filesChanged         BigInt?                     @map("files_changed")
  updatedAt            DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(3)
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "core_run_projections_organization_id_fkey")
  repository           Repository                  @relation(fields: [organizationId, repositoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "core_run_projections_org_repository_fkey")
  run                  Run                         @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict, map: "core_run_projections_org_run_fkey")
  commands             CoreCommandProjection[]
  tools                CoreToolProjection[]
  tests                CoreTestProjection[]
  gitSnapshots         CoreGitSnapshotProjection[]
  gitDiffs             CoreGitDiffProjection[]
  errors               CoreErrorProjection[]
  usage                CoreUsageProjection[]

  @@unique([organizationId, runId], map: "core_runs_org_run_key")
  @@index([organizationId, repositoryId, updatedAt, runId], map: "core_runs_org_repository_cursor_idx")
  @@map("core_run_projections")
}

model CoreCommandProjection {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  runId             String            @map("run_id") @db.Uuid
  operationId       String            @map("operation_id") @db.Uuid
  startEventId      String?           @map("start_event_id") @db.Uuid
  startSequence     BigInt?           @map("start_sequence")
  finishEventId     String?           @map("finish_event_id") @db.Uuid
  finishSequence    BigInt?           @map("finish_sequence")
  state             String
  outcome           String?
  durationMs        BigInt?           @map("duration_ms")
  exitCode          BigInt?           @map("exit_code")
  terminationSignal String?           @map("termination_signal")
  commandCapture    Json?             @map("command_capture") @db.JsonB
  workingDirectory  Json?             @map("working_directory") @db.JsonB
  stdoutCapture     Json?             @map("stdout_capture") @db.JsonB
  stderrCapture     Json?             @map("stderr_capture") @db.JsonB
  runProjection     CoreRunProjection @relation(fields: [organizationId, runId], references: [organizationId, runId], onDelete: Cascade, onUpdate: Restrict, map: "core_commands_org_run_projection_fkey")

  @@unique([runId, operationId], map: "core_commands_run_operation_key")
  @@index([organizationId, runId, startSequence], map: "core_commands_org_run_sequence_idx")
  @@map("core_command_projections")
}

model CoreToolProjection {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  runId          String            @map("run_id") @db.Uuid
  operationId    String            @map("operation_id") @db.Uuid
  startEventId   String?           @map("start_event_id") @db.Uuid
  startSequence  BigInt?           @map("start_sequence")
  finishEventId  String?           @map("finish_event_id") @db.Uuid
  finishSequence BigInt?           @map("finish_sequence")
  state          String
  toolName       String?           @map("tool_name")
  outcome        String?
  durationMs     BigInt?           @map("duration_ms")
  inputCapture   Json?             @map("input_capture") @db.JsonB
  outputCapture  Json?             @map("output_capture") @db.JsonB
  runProjection  CoreRunProjection @relation(fields: [organizationId, runId], references: [organizationId, runId], onDelete: Cascade, onUpdate: Restrict, map: "core_tools_org_run_projection_fkey")

  @@unique([runId, operationId], map: "core_tools_run_operation_key")
  @@index([organizationId, runId, startSequence], map: "core_tools_org_run_sequence_idx")
  @@map("core_tool_projections")
}

model CoreTestProjection {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  runId            String            @map("run_id") @db.Uuid
  testRunId        String            @map("test_run_id") @db.Uuid
  sourceEventId    String            @map("source_event_id") @db.Uuid
  sourceSequence   BigInt            @map("source_sequence")
  commandId        String?           @map("command_id") @db.Uuid
  framework        String
  outcome          String
  counts           Json?             @db.JsonB
  durationMs       BigInt?           @map("duration_ms")
  reportArtifactId String?           @map("report_artifact_id") @db.Uuid
