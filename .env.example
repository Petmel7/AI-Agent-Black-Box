# Reserved for later deployed runtime and direct-migration composition.
DATABASE_URL=
DIRECT_URL=

# Ingestion derives tenant identity from this UUID and authenticates bearer
# tokens against this lowercase SHA-256 digest. Never store the raw token here.
INGEST_ORGANIZATION_ID=
INGEST_BEARER_TOKEN_SHA256=

# Required by the ingestion process for private artifact transport. The bucket
# must be private. The service-role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ARTIFACT_STORAGE_BUCKET=
# May lower, but not exceed, the v0.1 ceiling of 50000000 bytes.
ARTIFACT_MAX_BYTES=50000000
INGEST_ARTIFACT_VERIFICATION_CONNECT_TIMEOUT_MS=10000
INGEST_ARTIFACT_VERIFICATION_INACTIVITY_TIMEOUT_MS=30000
INGEST_ARTIFACT_VERIFICATION_ATTEMPT_TIMEOUT_MS=240000

# Required only for BBX database migration and integration commands. It must
# name the explicitly isolated blackbox_test or blackbox_integration database.
TEST_DATABASE_URL=

# Worker-only direct PostgreSQL connection. Queue provisioning is an explicit
# operator command; normal startup verifies the private queue without creating it.
WORKER_DATABASE_URL=
WORKER_POLL_DELAY_MS=1000
WORKER_SHUTDOWN_WAIT_MS=30000
WORKER_RELAY_BATCH_SIZE=20
WORKER_RELAY_LEASE_SECONDS=60
WORKER_RELAY_MAX_ATTEMPTS=8
WORKER_QUEUE_BATCH_SIZE=10
WORKER_QUEUE_VISIBILITY_SECONDS=360
WORKER_POISON_READ_LIMIT=5
WORKER_EVENT_PAGE_SIZE=500
WORKER_MAX_EVENTS_PER_RUN=20000
WORKER_MAX_PROJECTED_CHILDREN=20000
WORKER_PROJECTION_LEASE_SECONDS=300
WORKER_PROJECTION_ATTEMPT_TIMEOUT_MS=240000
WORKER_PROJECTION_TRANSITION_MARGIN_MS=5000
WORKER_PROJECTION_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300

# Local collector. The default spool is the OS per-user application-data
# directory; keep any override outside captured repositories. Raw content is
# disabled unless its comma-separated capture class is listed explicitly.
# Wrapped children receive none of these values; only BLACKBOX_RUN_ID is added
# to their copied environment for future BBX-007/008 correlation.
BLACKBOX_SPOOL_DIR=
BLACKBOX_SPOOL_QUOTA_BYTES=1000000000
BLACKBOX_CAPTURE_INPUT_BYTES=10000000
BLACKBOX_CAPTURE_CLASSES=
BLACKBOX_REPOSITORY_ROOT=
BLACKBOX_REDACT_ENV_NAMES=
BLACKBOX_REDACT_LITERAL_FILE=

# Optional remote delivery. Leave all three empty for explicit offline mode.
# Production URLs must use HTTPS; loopback HTTP is accepted for local tests.
BLACKBOX_API_BASE_URL=
BLACKBOX_REPOSITORY_ID=
BLACKBOX_API_TOKEN=
# Bounded native HTTP and one-shot drain controls (milliseconds/counts).
BLACKBOX_CONNECT_TIMEOUT_MS=5000
BLACKBOX_REQUEST_TIMEOUT_MS=30000
BLACKBOX_OVERALL_TIMEOUT_MS=60000
BLACKBOX_DRAIN_MAX_ATTEMPTS=20
BLACKBOX_DRAIN_MAX_ITEMS=20
BLACKBOX_DRAIN_MAX_ELAPSED_MS=60000
BLACKBOX_RETRY_BASE_MS=1000
BLACKBOX_RETRY_MAX_MS=300000
# BBX-009B worker authenticated artifact reads (private server configuration only)
WORKER_STORAGE_CONNECT_TIMEOUT_MS=10000
WORKER_STORAGE_INACTIVITY_TIMEOUT_MS=15000
WORKER_STORAGE_CONCURRENCY=4
WORKER_MAX_FILE_ARTIFACTS_PER_RUN=100
WORKER_MAX_FILE_ARTIFACT_BYTES_PER_RUN=100000000
WORKER_MAX_FILE_ENTRIES_PER_RUN=20000
WORKER_MAX_FILE_ROWS_PER_RUN=20000
WORKER_ARTIFACT_INTENT_BACKFILL_LIMIT=1000
