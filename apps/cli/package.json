{
  "name": "@blackbox/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "blackbox": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/bin.ts",
    "lint": "eslint .",
    "pretest": "pnpm run build",
    "start": "node --enable-source-maps dist/bin.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blackbox/contracts": "workspace:*"
  },
  "devDependencies": {
    "@blackbox/config": "workspace:*",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
